{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["dom", "dom.iterable", "esnext"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"types": ["vite/client"],
		"paths": {
			"@/*": ["../web/src/*"]
		}
	},
	// `../web/src/types` carries the editor's ambient declarations (`EyeDropper`,
	// `soundtouchjs`). `apps/web/tsconfig.json` picks them up via its own
	// `src/types/**/*.d.ts` entry; without the equivalent here, type-checking the
	// example reports three errors that exist only because of this config gap.
	"include": [
		"src",
		"build",
		"tests",
		"vite.config.ts",
		"vite.headless.config.ts",
		"playwright.config.ts",
		"playwright.surface.config.ts",
		"playwright.probe.config.ts",
		"../web/src/types/**/*.d.ts"
	]
}
