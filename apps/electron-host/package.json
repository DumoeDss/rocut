		"react-dom": "18.3.1"
	},
	"devDependencies": {
		"@playwright/test": "^1.55.0",
		"@tailwindcss/postcss": "^4.2.1",
		"@types/bun": "latest",
		"@types/react": "18.3.28",
		"@types/react-dom": "18.3.7",
		"@vitejs/plugin-react": "^5.0.0",
		"electron": "43.4.0",
		"postcss": "^8",
		"tailwindcss": "^4.2.1",
		"typescript": "^5.8.3",
		"vite": "^7.0.0",
		"vite-plugin-top-level-await": "^1.6.0",
		"vite-plugin-wasm": "^3.5.0"
	}
