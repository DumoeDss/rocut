{
	"name": "@opencut/electron-host",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "electron/main.cjs",
	"scripts": {
		"build": "vite build && bun build src/store/main-store-ipc.ts --target=node --format=cjs --outfile=dist-main/main-store-ipc.cjs",
