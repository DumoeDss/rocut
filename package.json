{
  "name": "opencut",
  "packageManager": "bun@1.2.18",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:tools": "turbo run build --filter=@opencut/tools",
    "build:wasm": "node script/build-wasm.mjs",
    "check:packages": "node script/check-package-boundary.mjs",
    "check:packed-closure": "node script/check-packed-manifest-closure.mjs",
    "check:surface-labels": "node script/check-sdk-surface-labels.mjs",
    "check:wasm": "node script/check-wasm-source.mjs && node script/check-wasm-paths.mjs && node script/check-wasm-api-surface.mjs && node script/check-wasm-init.mjs",
    "check:wasm:reproducible": "node script/check-wasm-reproducible.mjs",
    "preinstall": "node script/check-wasm-source.mjs --preflight",
    "build:web": "turbo run build --filter=@opencut/web",
    "deploy:web": "turbo run deploy --filter=@opencut/web",
    "dev:tools": "turbo run dev --filter=@opencut/tools",
    "dev:wasm": "cargo watch -w rust/crates -w rust/wasm/src -s 'node script/build-wasm.mjs && bun install'",
    "dev:web": "turbo run dev --filter=@opencut/web",
    "format:web": "prettier packages/editor-classic/src/services/renderer --write",
    "generate:fonts": "npx tsx apps/web/scripts/generate-font-sprites.ts",
    "lint:web": "eslint apps/web/src packages/editor-classic/src packages/editor-contracts/src packages/editor-ports/src --ext .ts,.tsx",
    "lint:web:fix": "eslint apps/web/src packages/editor-classic/src packages/editor-contracts/src packages/editor-ports/src --ext .ts,.tsx --fix",
    "preview:web": "turbo run preview --filter=@opencut/web",
    "publish:wasm": "bun run build:wasm && npm publish rust/wasm/pkg --access public",
    "start:tools": "turbo run start --filter=@opencut/tools",
    "test": "bun test"
  },
  "dependencies": {
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "better-auth": "^1.4.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "next": "^16.1.3",
    "opencut": ".",
    "opencut-wasm": "file:./rust/wasm/pkg"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@next/eslint-plugin-next": "^16.2.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "prettier": "^3.8.3",
    "turbo": "^2.8.20",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.59.0"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide"
  ]
}
