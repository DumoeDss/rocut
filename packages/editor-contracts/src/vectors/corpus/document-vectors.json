		{
			"id": "document/create-track-and-clone",
			"title": "Creating a track advances the revision, notifies once, and hands back a defensive copy",
			"initialDocument": {
				"project": {
					"id": "vector-project",
					"name": "Vector corpus project",
					"frameRate": { "numerator": 30, "denominator": 1 },
					"canvasWidth": 1920,
					"canvasHeight": 1080
				},
				"tracks": [
					{ "id": "track-video", "kind": "video", "name": "Video lane", "hidden": false },
					{ "id": "track-text", "kind": "text", "name": "Caption lane", "hidden": false }
				],
				"clips": [
					{
						"id": "clip-caption",
						"trackId": "track-text",
						"startTime": 0,
						"duration": 40000,
						"trimStart": 0,
						"trimEnd": 0
					}
				],
				"assets": [
					{
						"id": "asset-reel",
						"kind": "video",
						"name": "Reel",
						"duration": 1200000,
						"width": 1920,
						"height": 1080
					}
				],
				"markers": [{ "id": "marker-open", "time": 0, "note": "open" }]
			},
			"batch": {
				"operations": [
					{
						"kind": "create-track",
						"track": {
							"id": "track-graphic",
							"kind": "graphic",
							"name": "Graphic lane",
							"hidden": false
						}
					}
				]
			},
			"expect": {
				"outcome": "accepted",
				"revisionDelta": 1,
				"watchDelta": 1,
				"createdIds": ["track-graphic"],
				"changedIds": [],
				"reads": [
					{
						"entity": "track",
						"id": "track-graphic",
						"fields": { "kind": "graphic", "name": "Graphic lane", "hidden": false }
					}
				],
				"clones": [
					{
						"entity": "track",
						"id": "track-graphic",
						"field": "name",
						"mutateTo": "mutated by the caller"
					}
				]
			}
		},
